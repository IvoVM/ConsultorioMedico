  "components": {
    "schemas": {
      "LoginCommand": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string" }, "password": { "type": "string" } } },
      "TokenDto": { "type": "object", "required": ["token", "email", "nombre", "rol", "debeCambiarClave"], "properties": { "token": { "type": "string" }, "email": { "type": "string" }, "nombre": { "type": "string" }, "rol": { "type": "string" }, "tenantSlug": { "type": "string", "nullable": true }, "debeCambiarClave": { "type": "boolean" } } },
      "AltaTenantCommand": { "type": "object", "required": ["slug", "nombre", "tipo"], "properties": { "slug": { "type": "string" }, "nombre": { "type": "string" }, "tipo": { "type": "string" } } },
      "CambiarEstadoTenantCommand": { "type": "object", "required": ["estado"], "properties": { "estado": { "type": "string" } } },
      "TenantDto": { "type": "object", "required": ["id", "slug", "nombre", "tipo", "estado", "creadoEn"], "properties": { "id": { "type": "string" }, "slug": { "type": "string" }, "nombre": { "type": "string" }, "tipo": { "type": "string" }, "estado": { "type": "string" }, "creadoEn": { "type": "string" } } },
      "RegistroPacienteCommand": { "type": "object", "required": ["email", "password", "nombre", "apellido", "documento", "fechaNacimiento", "telefono"], "properties": { "email": { "type": "string" }, "password": { "type": "string" }, "nombre": { "type": "string" }, "apellido": { "type": "string" }, "documento": { "type": "string" }, "fechaNacimiento": { "type": "string" }, "telefono": { "type": "string" } } },
      "SedeDto": { "type": "object", "required": ["id", "nombre", "direccion", "activa"], "properties": { "id": { "type": "string" }, "nombre": { "type": "string" }, "direccion": { "type": "string" }, "activa": { "type": "boolean" } } },
      "GuardarSedeCommand": { "type": "object", "required": ["nombre", "direccion"], "properties": { "nombre": { "type": "string" }, "direccion": { "type": "string" } } },
      "ServicioDto": { "type": "object", "required": ["id", "sedeId", "nombre"], "properties": { "id": { "type": "string" }, "sedeId": { "type": "string" }, "nombre": { "type": "string" } } },
      "GuardarServicioCommand": { "type": "object", "required": ["sedeId", "nombre"], "properties": { "sedeId": { "type": "string" }, "nombre": { "type": "string" } } },
      "EspecialidadDto": { "type": "object", "required": ["id", "nombre"], "properties": { "id": { "type": "string" }, "nombre": { "type": "string" } } },
      "GuardarEspecialidadCommand": { "type": "object", "required": ["nombre"], "properties": { "nombre": { "type": "string" } } },
      "TipoTurnoDto": { "type": "object", "required": ["id", "nombre", "duracionMinutos"], "properties": { "id": { "type": "string" }, "nombre": { "type": "string" }, "duracionMinutos": { "type": "integer" }, "especialidadId": { "type": "string", "nullable": true } } },
      "GuardarTipoTurnoCommand": { "type": "object", "required": ["nombre", "duracionMinutos"], "properties": { "nombre": { "type": "string" }, "duracionMinutos": { "type": "integer" }, "especialidadId": { "type": "string", "nullable": true } } },
      "ProfesionalDto": { "type": "object", "required": ["id", "nombre", "apellido", "email"], "properties": { "id": { "type": "string" }, "nombre": { "type": "string" }, "apellido": { "type": "string" }, "email": { "type": "string" }, "matricula": { "type": "string", "nullable": true }, "especialidadId": { "type": "string", "nullable": true } } },
      "ImportarEmpleadosCommand": { "type": "object", "required": ["csv"], "properties": { "csv": { "type": "string" } } },
      "EmpleadoCreadoDto": { "type": "object", "required": ["fila", "email", "claveTemporal", "rol"], "properties": { "fila": { "type": "integer" }, "email": { "type": "string" }, "claveTemporal": { "type": "string" }, "rol": { "type": "string" } } },
      "FilaRechazadaDto": { "type": "object", "required": ["fila", "motivo"], "properties": { "fila": { "type": "integer" }, "motivo": { "type": "string" } } },
      "ImportacionEmpleadosDto": { "type": "object", "required": ["creados", "rechazados"], "properties": { "creados": { "type": "array", "items": { "$ref": "#/components/schemas/EmpleadoCreadoDto" } }, "rechazados": { "type": "array", "items": { "$ref": "#/components/schemas/FilaRechazadaDto" } } } },
      "BloqueAgendaDto": { "type": "object", "required": ["id", "dia", "horaDesde", "horaHasta", "sedeId", "tipoTurnoId"], "properties": { "id": { "type": "string" }, "dia": { "type": "string" }, "horaDesde": { "type": "string" }, "horaHasta": { "type": "string" }, "sedeId": { "type": "string" }, "tipoTurnoId": { "type": "string" } } },
      "GuardarAgendaCommand": { "type": "object", "required": ["profesionalId", "bloques"], "properties": { "profesionalId": { "type": "string" }, "bloques": { "type": "array", "items": { "$ref": "#/components/schemas/BloqueAgendaDto" } } } },
      "BloqueoDto": { "type": "object", "required": ["id", "profesionalId", "inicio", "fin", "motivo"], "properties": { "id": { "type": "string" }, "profesionalId": { "type": "string" }, "inicio": { "type": "string" }, "fin": { "type": "string" }, "motivo": { "type": "string" } } },
      "CrearBloqueoCommand": { "type": "object", "required": ["profesionalId", "inicio", "fin", "motivo"], "properties": { "profesionalId": { "type": "string" }, "inicio": { "type": "string" }, "fin": { "type": "string" }, "motivo": { "type": "string" } } },
